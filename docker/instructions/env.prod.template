# Production Environment Variables Template
# Copy this to .env.prod and fill in your actual values

# Environment
NODE_ENV=production

# Database Configuration
MYSQL_CONTAINER_NAME=lovable-mysql-prod
MYSQL_ROOT_PASSWORD=your_secure_mysql_root_password
MYSQL_DATABASE=lovable_prod
MYSQL_USER=lovable_user
MYSQL_PASSWORD=your_secure_mysql_password
MYSQL_PORT=3306
DATABASE_URL=mysql://lovable_user:your_secure_mysql_password@mysql:3306/lovable_prod

# Application Configuration
APP_CONTAINER_NAME=lovable-app-prod
APP_PORT=3000

# Inngest Configuration
INNGEST_CONTAINER_NAME=lovable-inngest-prod
INNGEST_PORT=8288
INNGEST_DEV=false
INNGEST_BASE_URL=https://your-domain.com/api/inngest
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

# API Keys
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
E2B_API_KEY=your_e2b_api_key

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Docker Hub Configuration
DOCKERHUB_USERNAME=your_dockerhub_username

# Deployment Configuration
DEPLOYMENT_VERSION=prod-$(date +%s)
