# Development Environment Variables Template
# Copy this to .env.dev and fill in your actual values

# Environment
NODE_ENV=development

# Database Configuration
MYSQL_CONTAINER_NAME=lovable-mysql-dev
MYSQL_ROOT_PASSWORD=dev_password
MYSQL_DATABASE=lovable_dev
MYSQL_USER=lovable_user
MYSQL_PASSWORD=dev_password
MYSQL_PORT=3307
DATABASE_URL=mysql://lovable_user:dev_password@mysql:3306/lovable_dev

# Application Configuration
APP_CONTAINER_NAME=lovable-app-dev
APP_PORT=3001

# Inngest Configuration
INNGEST_CONTAINER_NAME=lovable-inngest-dev
INNGEST_PORT=8289
INNGEST_DEV=true
INNGEST_BASE_URL=http://localhost:3001/api/inngest
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

# API Keys (use development/test keys)
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
E2B_API_KEY=your_e2b_api_key

# Clerk Authentication (use development keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Docker Hub Configuration
DOCKERHUB_USERNAME=your_dockerhub_username
