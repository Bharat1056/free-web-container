# ---------------------------------------------------------------------------
# Database (PostgreSQL) — used by Prisma
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# ---------------------------------------------------------------------------
# AI / LLM providers
# ---------------------------------------------------------------------------
# Google Gemini — embeddings (RAG) only
GEMINI_API_KEY=""

# OpenAI — all text generation (decision, enhancement, edit intent, validation,
# and tool-based code generation).
OPENAI_API_KEY=""

# Optional per-role model overrides (restart required). When set, that model is
# tried first; then the primary + fallbacks from MODELS in src/constants.ts.
# MODEL_DECISION="gpt-4.1-mini"
# MODEL_EDIT_INTENT="gpt-4.1-mini"
# MODEL_ENHANCEMENT="gpt-4.1"
# MODEL_CODE="gpt-4.1"
# MODEL_PROMPT_VALIDATION="gpt-4.1-mini"
# MODEL_EMBEDDING="gemini-embedding-001"

# ---------------------------------------------------------------------------
# E2B — cloud sandboxes that run the generated Next.js app
# ---------------------------------------------------------------------------
E2B_API_KEY=""

# ---------------------------------------------------------------------------
# Better Auth — Google sign-in
# ---------------------------------------------------------------------------
# Secret used to sign sessions (min 32 chars). Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public URL of this app (must match Google OAuth redirect base)
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Google Cloud Console → OAuth client → Authorized redirect URI:
#   {BETTER_AUTH_URL}/api/auth/callback/google

# ---------------------------------------------------------------------------
# Razorpay — Pro checkout
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Optional webhook verification for payment.captured
# RAZORPAY_WEBHOOK_SECRET=""
# Amount in smallest currency unit (default 99900 = ₹999.00)
# RAZORPAY_PRO_AMOUNT="99900"
# RAZORPAY_CURRENCY="INR"
# Label shown on the pricing page
# NEXT_PUBLIC_PRO_PRICE_LABEL="$10 / month"
# How long a paid upgrade lasts (days). Coupon durationDays can override.
# PRO_DURATION_DAYS="30"

# ---------------------------------------------------------------------------
# Inngest — background job pipeline
# ---------------------------------------------------------------------------
# Option A — Local Inngest Dev Server (offline, no cloud dashboard):
#   INNGEST_DEV="1"
#   INNGEST_BASE_URL="http://localhost:8288"
#   (EVENT_KEY / SIGNING_KEY not required)
#
# Option B — Inngest Cloud while developing locally (see runs in their UI):
#   Do NOT set INNGEST_DEV.
#   Use Cloud EVENT_KEY + SIGNING_KEY below.
#   Tunnel localhost and register that URL in Inngest (e.g. ngrok):
#   https://xxxx.ngrok-free.app/api/inngest
#
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public base URL of the app (used by the tRPC client + Better Auth)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
