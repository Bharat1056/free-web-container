# Database
DATABASE_URL="mysql://lovable:lovablepassword@localhost:3306/lovable"

# Inngest Configuration
INNGEST_DEV=1
INNGEST_BASE_URL="http://localhost:8288"
INNGEST_EVENT_KEY="your-event-key-here"
INNGEST_SIGNING_KEY="your-signing-key-here"

# Clerk Authentication (Add your actual keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="your-clerk-publishable-key"
CLERK_SECRET_KEY="your-clerk-secret-key"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# Groq API (Add your actual key)
GROQ_API_KEY="your-groq-api-key"

# E2B API (Add your actual key)
E2B_API_KEY="your-e2b-api-key"

# App Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret"

# Development
NODE_ENV="development"
