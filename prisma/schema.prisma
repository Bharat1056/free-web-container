generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Project {
  id String @id @default(cuid())
  name String @db.VarChar(255)
  userId String @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages   Message[]
  codeChunks CodeChunk[]
  codeEdges  CodeEdge[]

}

enum MessageRole {
  USER
  ASSISTANT
}

enum MessageType {
  RESULT
  ERROR
}

model Message {
  id String @id @default(cuid())
  content String @db.Text
  role MessageRole
  type MessageType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  fragment Fragment?
}

model Fragment {
  id String @id @default(cuid())
  messageId String @unique
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  sandboxUrl String @db.VarChar(500)
  title String @db.VarChar(255)
  files Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Usage {
  key String @id
  points Int
  expire DateTime?
}

/**
 * AST / line chunks of the project's latest codebase for hybrid retrieval.
 * Scoped by projectId only (not per historical fragment).
 */
model CodeChunk {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  path        String
  startLine   Int
  endLine     Int
  content     String
  contentHash String
  embedding   Float[]  @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, path, startLine, endLine])
  @@index([projectId])
  @@index([projectId, path])
  @@index([projectId, contentHash])
}

/**
 * Import edges from madge (file A imports file B) for related-file expansion.
 */
model CodeEdge {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromPath  String
  toPath    String
  kind      String  @default("IMPORTS")

  @@unique([projectId, fromPath, toPath, kind])
  @@index([projectId, fromPath])
  @@index([projectId, toPath])
}
